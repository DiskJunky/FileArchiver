<Window x:Class="FileArchiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="File Archiver" Height="850" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Icon="Resources/FileArchiver.png"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

            <Window.Resources>
        <!-- Custom Archive Button Style with theme support -->
        <Style x:Key="ArchiveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ArchiveButtonBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource DisabledBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ArchiveButtonHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource ControlBackgroundBrush}">
            <MenuItem Header="_File" Foreground="{DynamicResource TextForegroundBrush}">
                <MenuItem Header="_Exit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Theme" Foreground="{DynamicResource TextForegroundBrush}">
                <MenuItem Header="_Light" Command="{Binding LightThemeCommand}" 
                          IsChecked="{Binding IsLightThemeChecked}" x:Name="LightThemeMenuItem"/>
                <MenuItem Header="_Dark" Command="{Binding DarkThemeCommand}" 
                          IsChecked="{Binding IsDarkThemeChecked}" x:Name="DarkThemeMenuItem"/>
                <Separator/>
                <MenuItem Header="_System Default" Command="{Binding SystemThemeCommand}" 
                          IsChecked="{Binding IsSystemThemeChecked}" x:Name="SystemThemeMenuItem"/>
            </MenuItem>
            <MenuItem Header="_Help" Foreground="{DynamicResource TextForegroundBrush}">
                <MenuItem Header="_About" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource ControlBackgroundBrush}" 
                   Height="35" Padding="5,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- Progress Section -->
            <StatusBarItem Grid.Column="0" x:Name="ProgressStatusItem" 
                           Visibility="{Binding ProgressStatusVisibility}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ProgressText" Text="{Binding ProgressText}" FontSize="12" Margin="0,0,10,0" 
                               VerticalAlignment="Center"/>
                    <ProgressBar x:Name="ProgressBar" Width="200" Height="18" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressValue}"
                                 VerticalAlignment="Center" Foreground="{DynamicResource ProgressBarBrush}"/>
                </StackPanel>
            </StatusBarItem>

            <!-- Spacer -->
            <StatusBarItem Grid.Column="1"/>

            <!-- Archive Info Section -->
            <StatusBarItem Grid.Column="2" x:Name="ArchiveInfoStatusItem" 
                           Visibility="{Binding ArchiveInfoStatusVisibility}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ArchiveExistsText" Text="{Binding ArchiveExistsText}" FontSize="12" Margin="0,0,15,0" 
                               Foreground="{Binding ArchiveExistsColor}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="ArchiveFileCountText" Text="{Binding ArchiveFileCountText}" FontSize="12" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>

            <!-- Separator -->
            <Separator Grid.Column="3" x:Name="StatusSeparator" 
                       Visibility="{Binding StatusSeparatorVisibility}"/>

            <!-- Log Folder Link -->
            <StatusBarItem Grid.Column="4">
                <TextBlock VerticalAlignment="Center">
                    <Hyperlink Command="{Binding OpenLogFolderCommand}" 
                               ToolTip="Click to open the log folder">
                        <Run Text="📁 Log Folder"/>
                    </Hyperlink>
                </TextBlock>
            </StatusBarItem>

            <!-- Separator -->
            <Separator Grid.Column="5"/>

            <!-- Ready Status -->
            <StatusBarItem Grid.Column="6">
                <TextBlock x:Name="ReadyStatusText" Text="Ready" FontSize="12" 
                           Visibility="{Binding ReadyStatusVisibility}"
                           VerticalAlignment="Center"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content -->
        <Grid Margin="10" x:Name="MainContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="400"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="1*" MinHeight="150"/>
            </Grid.RowDefinitions>

            <!-- Main Content Area -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search Configuration Panel -->
                <GroupBox Grid.Row="0" Header="File Search" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <!-- Source Folder Row -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Source Folder:" 
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   FontWeight="SemiBold" FontSize="13"/>
                        <TextBox x:Name="FolderPathTextBox" Grid.Row="0" Grid.Column="1" 
                                 Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsUIEnabled}"
                                 VerticalAlignment="Center" Padding="5" FontSize="14"/>
                        <Button x:Name="BrowseButton" Grid.Row="0" Grid.Column="2" 
                                Content="Browse..." Margin="10,0,0,0" 
                                Command="{Binding BrowseCommand}" 
                                IsEnabled="{Binding IsUIEnabled}"
                                Padding="5"/>

                        <!-- Search Criteria Row -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Search Criteria:" 
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   FontWeight="SemiBold" FontSize="13"/>
                        <TextBox x:Name="SearchTextBox" Grid.Row="2" Grid.Column="1" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsUIEnabled}"
                                 VerticalAlignment="Center" Padding="5" FontSize="14" 
                                 ToolTip="Enter file name search terms (all words must match)"
                                 KeyDown="SearchTextBox_KeyDown"/>
                        <Button x:Name="ScanButton" Grid.Row="2" Grid.Column="2" 
                                Content="Scan Files" Margin="10,0,0,0" 
                                Command="{Binding ScanCommand}" 
                                IsEnabled="{Binding IsScanButtonEnabled}"
                                Padding="5" FontWeight="Bold"/>
                    </Grid>
                </GroupBox>

                <!-- Preview List -->
                <GroupBox Grid.Row="1" Header="Preview - Files Found" Padding="10" Margin="0,0,0,10">
                    <ListView x:Name="FilesListView" ItemsSource="{Binding FileItems}" SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="400">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FileName}" ToolTip="{Binding FullPath}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Size" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FileSizeFormatted}" TextAlignment="Right"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Status" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ExistsInArchive}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Action" Width="220">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox Content="Archive" IsChecked="{Binding IsSelected}" 
                                                          Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <CheckBox Content="Overwrite" IsChecked="{Binding AllowOverwrite}" 
                                                          IsEnabled="{Binding ExistsInArchive}"
                                                          VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>

                <!-- Selection Actions and Archive Button -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Selection Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="SelectAllButton" Content="Select All" Width="100" 
                                Margin="0,0,10,0" Command="{Binding SelectAllCommand}" 
                                IsEnabled="{Binding IsUIEnabled}"
                                Padding="5"/>
                        <Button x:Name="DeselectAllButton" Content="Deselect All" Width="100" 
                                Command="{Binding DeselectAllCommand}"
                                IsEnabled="{Binding IsUIEnabled}"
                                Padding="5"/>
                        <TextBlock x:Name="SelectionCountText" Text="{Binding SelectionCountText}" VerticalAlignment="Center" 
                                   Margin="20,0,0,0" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Right: Archive Button -->
                    <Button x:Name="ArchiveButton" Grid.Column="2" Content="Archive Selected Files" 
                            Width="250" Height="40" FontSize="16" FontWeight="Bold" 
                            Command="{Binding ArchiveCommand}"
                            IsEnabled="{Binding IsArchiveButtonEnabled}"
                            Style="{StaticResource ArchiveButtonStyle}"/>
                </Grid>
            </Grid>

            <!-- Horizontal GridSplitter -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" 
                          VerticalAlignment="Center"
                          Background="{DynamicResource SplitterBrush}" ShowsPreview="False"/>

            <!-- Activity/Status Log Panel -->
            <GroupBox Grid.Row="2" Header="Activity / Status" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Activity Log ListView -->
                    <ListView x:Name="ActivityLogListView" ItemsSource="{Binding ActivityLog}" Grid.Row="0"
                              FontFamily="Consolas" FontSize="11"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Timestamp" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Timestamp}" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Message" Width="800">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource ConsoleTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Clear Log Button -->
                    <Button x:Name="ClearLogButton" Grid.Row="1" Content="Clear Log" 
                            Margin="0,10,0,0" Padding="5" Command="{Binding ClearLogCommand}"/>
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>