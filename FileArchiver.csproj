<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\FileArchiver.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="FileArchiver.Tests\**" />
    <EmbeddedResource Remove="FileArchiver.Tests\**" />
    <None Remove="FileArchiver.Tests\**" />
    <Page Remove="FileArchiver.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\FileArchiver.ico" />
    <None Remove="Resources\FileArchiver.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\FileArchiver.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\FileArchiver.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\FileArchiver.png" />
  </ItemGroup>

</Project>
